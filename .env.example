# Copia este archivo como .env y ajusta los valores.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=classroom_db

JWT_SECRET=cambia-esta-clave-en-produccion
JWT_EXPIRES_IN=7d

# Ruta relativa: Vite hace proxy de /api hacia PORT (ver vite.config.ts).
VITE_API_URL=/api
